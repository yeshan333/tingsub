{
  "name": "tingsub-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests-js/*.test.js",
    "test:browser": "node tests-js/browser.mjs",
    "test:live": "node tests-js/live-capture.mjs",
    "check": "node scripts/check-extension.mjs",
    "test:desktop": "node tests-js/desktop.mjs",
    "test:overlay": "node tests-js/overlay.mjs",
    "test:site": "node --test tests-js/site.mjs",
    "dev:desktop": "uv run --frozen tingsub gui",
    "build:desktop": "uv run --frozen --group bundle python scripts/build_desktop.py",
    "test:native": "uv run --frozen python scripts/check_desktop_native.py --no-inference",
    "test:youtube": "node tests-js/youtube-live.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "version": "0.3.0",
  "description": "Local bilingual live captions for Chrome",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
